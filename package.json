{
    "name": "vest-visuals",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && tsc --noEmit && npm run build:migrate",
        "build:migrate": "node_modules/esbuild/bin/esbuild server/migrate.ts --bundle --platform=node --format=cjs --target=node24 --external:pg-native --outfile=.output/migrate.cjs",
        "preview": "vite preview",
        "start": "node .output/server/index.mjs",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "format:check": "prettier --check .",
        "machine-translate": "inlang machine translate --project project.inlang",
        "better-auth:generate": "auth generate --config=./better-auth.config.ts --output=./src/lib/server/db/schema/auth.ts --yes",
        "drizzle:generate": "drizzle-kit generate",
        "drizzle:migrate": "node --env-file=.env server/migrate.ts",
        "drizzle:baseline": "node --env-file=.env server/migrate.ts --baseline",
        "drizzle:push": "drizzle-kit push",
        "drizzle:pull": "drizzle-kit pull",
        "drizzle:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/lib-storage": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "@base-ui/react": "^1.9.0",
        "@beautiful-qr-code/react": "^1.0.11",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@icons-pack/react-simple-icons": "^13.15.1",
        "@inlang/paraglide-js-react": "^1.0.3",
        "@marsidev/react-turnstile": "^1.6.3",
        "@react-email/components": "^1.0.12",
        "@tabler/icons-react": "^3.50.0",
        "@tanstack/react-devtools": "^0.10.14",
        "@tanstack/react-query": "^5.105.1",
        "@tanstack/react-query-devtools": "^5.105.1",
        "@tanstack/react-router": "^1.170.38",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.4",
        "@tanstack/react-table": "^9.3.1",
        "@uidotdev/usehooks": "^2.4.1",
        "@workflow/world-postgres": "^5.1.1",
        "archiver": "^8.0.0",
        "better-auth": "^1.7.15",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "country-flag-icons": "^1.6.20",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.45.4",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "pg": "^8.23.1",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "resend": "^6.37.0",
        "satori": "^0.63.2",
        "shadcn": "^4.23.0",
        "sharp": "^0.35.5",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "uuid": "^14.0.3",
        "workflow": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@inlang/cli": "^3.4.5",
        "@inlang/paraglide-js": "^2.29.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/devtools-vite": "^0.8.6",
        "@tanstack/eslint-config": "^0.4.0",
        "@types/archiver": "^8.0.0",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "auth": "^1.7.15",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "nitro": "^3.0.261103-rc",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.2.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "vite-plugin-svgr": "^5.2.0"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "@swc/core@1.15.3": true,
        "better-sqlite3@12.11.1": true,
        "cbor-extract@2.2.2": true,
        "@prisma/client@5.22.0": true,
        "unrs-resolver@1.12.2": true
    }
}
