{
    "name": "vest-visuals",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && tsc --noEmit",
        "preview": "vite preview",
        "start": "node .output/server/index.mjs",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "format:check": "prettier --check .",
        "machine-translate": "inlang machine translate --project project.inlang",
        "better-auth:generate": "better-auth generate --config=./better-auth.config.ts --output=./src/lib/server/db/schema/auth.ts --yes",
        "drizzle:generate": "drizzle-kit generate",
        "drizzle:migrate": "drizzle-kit migrate",
        "drizzle:push": "drizzle-kit push",
        "drizzle:pull": "drizzle-kit pull",
        "drizzle:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1136.0",
        "@aws-sdk/s3-request-presigner": "^3.1136.0",
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tabler/icons-react": "^3.47.0",
        "@tanstack/react-devtools": "^0.10.12",
        "@tanstack/react-query": "^5.103.2",
        "@tanstack/react-query-devtools": "^5.103.2",
        "@tanstack/react-router": "^1.170.38",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.168.56",
        "@uidotdev/usehooks": "^2.4.1",
        "animejs": "^4.5.0",
        "better-auth": "^1.7.5",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.2",
        "dotenv": "^18.0.2",
        "drizzle-orm": "^0.45.3",
        "pg": "^8.23.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-google-recaptcha-v3": "^1.11.0",
        "shadcn": "^4.21.0",
        "sharp": "^0.35.4",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "uuid": "^14.0.2",
        "workflow": "^4.8.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@better-auth/cli": "^1.4.22",
        "@inlang/cli": "^3.0.0",
        "@inlang/paraglide-js": "^2.25.4",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/eslint-config": "^0.4.0",
        "@types/node": "^22.5.4",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@types/uuid": "^10.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.11.0",
        "nitro": "^3.0.260311-beta",
        "prettier": "^3.9.8",
        "tailwindcss": "^4.2.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.0.14"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "@swc/core@1.15.3": true,
        "better-sqlite3@12.11.1": true,
        "cbor-extract@2.2.2": true,
        "@prisma/client@5.22.0": true,
        "unrs-resolver@1.12.2": true
