# Copy to deploy/base/.env on the VPS (never commit it) and keep the values in your password manager.

# the VPS's public IP or a DNS name pointing at it (not proxied by Cloudflare): where WireGuard clients connect
WG_HOST=
# wg-easy's UI login (user "admin")
WG_PASSWORD=
# Portainer's admin password, at least 12 characters
PORTAINER_PASSWORD=
