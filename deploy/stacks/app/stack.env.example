# The app stack's variables: paste them into the stack's environment variables in Portainer, which saves them as
# stack.env. Keep the filled in copy in your password manager. See also .env.example at the repository's root.

# the image: whose GitHub packages (lowercase), and which build, a commit sha from the "images" workflow
GITHUB_OWNER=
APP_VERSION=

# each site's host
PUBLIC_REWRITE_BRIDGE_HOME=vestvisuals.ro
PUBLIC_REWRITE_BRIDGE_ACCOUNT=a.vestvisuals.ro
PUBLIC_REWRITE_BRIDGE_MEDIA=media.vestvisuals.ro
PUBLIC_REWRITE_BRIDGE_SOFTWARE=software.vestvisuals.ro
PUBLIC_REWRITE_BRIDGE_ADMIN=admin.vestvisuals.ro
PUBLIC_COOKIE_DOMAIN=.vestvisuals.ro

# public files, each R2 bucket on its own domain
PUBLIC_S3_URL=https://{bucket}.vestvisuals.ro
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_GA_MEASUREMENT_ID=

# the db stack's database
DATABASE_URL=postgres://vest:<password>@postgres:5432/vest

BETTER_AUTH_URL=https://a.vestvisuals.ro
# generate one: openssl rand -base64 48
BETTER_AUTH_SECRET=

# R2's S3 api, with a token that can read and write the app's buckets
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

RESEND_API_KEY=
MAIL_SENDER_ADDRESS=noreply@vestvisuals.ro
DISCORD_CONTACT_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=
