# The db stack's variables: paste them into the stack's environment variables in Portainer (Advanced mode takes
# the whole block at once, without these comments). Portainer makes them available to compose.yml, which passes
# each one to the containers; keep the filled in copy in your password manager.

# whose GitHub packages the backup image is pulled from, lowercase
GITHUB_OWNER=

# the database; the app stack's DATABASE_URL uses the same values: postgres://vest:<password>@postgres:5432/vest
POSTGRES_USER=vest
POSTGRES_PASSWORD=
POSTGRES_DB=vest

# backups (see docker/backup): when, in cron format and UTC, and for how long they're kept
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30
# encrypts the dumps; without it they're stored as they are. Losing it means losing the backups, keep it safe
BACKUP_PASSPHRASE=
# an Uptime Kuma push monitor's url, called after each backup, so a missed one raises an alert; optional
BACKUP_HEARTBEAT_URL=

# where the dumps go: a bucket of their own, with an R2 token that can only write to it
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_BUCKET=vest-visuals-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
