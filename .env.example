#
# CLIENT
#
PUBLIC_REWRITE_BRIDGE_HOME= # "localhost:3000"
PUBLIC_REWRITE_BRIDGE_ACCOUNT= # "a.localhost:3000"
PUBLIC_REWRITE_BRIDGE_MEDIA= # "media.localhost:3000"
PUBLIC_REWRITE_BRIDGE_SOFTWARE= # "software.localhost:3000"
PUBLIC_REWRITE_BRIDGE_ADMIN= # "admin.localhost:3000"
# Shared by every subdomain (auth session, theme). Leave empty on localhost.
PUBLIC_COOKIE_DOMAIN= # ".example.com"
# Where public files are served from, {bucket} being the bucket's short name (assets, avatars, portfolio, albums); files are at {url}/{key}
# MinIO serves every bucket from one host, R2 gives each public bucket its own domain: "https://{bucket}.vestvisuals.ro"
PUBLIC_S3_URL= # "http://localhost:9000/{bucket}"
# Cloudflare Turnstile test keys that always pass: site 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics, loaded only after visitors accept analytics cookies; empty for none
PUBLIC_GA_MEASUREMENT_ID= # "G-XXXXXXXXXX"


#
# SERVER
#
# Database URL for PostgreSQL
DATABASE_URL= # "postgresql://username:password@localhost:5432/mydb"

# Better Auth configuration
BETTER_AUTH_URL= # "http://a.localhost:3000"
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# S3 storage (MinIO, AWS, R2, ...)
S3_ENDPOINT= # "http://localhost:9000"
S3_REGION= # "us-east-1", the default; MinIO accepts any
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true for MinIO and most self hosted ones (endpoint/bucket/key), false for AWS (bucket.endpoint/key)
S3_FORCE_PATH_STYLE= # "true", the default

# Cloudflare, to purge replaced files from its cache; optional, nothing is purged without them
CLOUDFLARE_ZONE_ID= # the domain's zone id, from its overview page
CLOUDFLARE_API_TOKEN= # a token with the Zone > Cache Purge permission

# Email, through Resend; without the key, emails are printed to the server's console instead
RESEND_API_KEY=
MAIL_SENDER_ADDRESS= # "noreply@example.com", its domain verified in Resend

# The contact forms post to a Discord channel's webhook; without it, messages are printed to the console
DISCORD_CONTACT_WEBHOOK_URL= # "https://discord.com/api/webhooks/…"

# Cloudflare Turnstile test keys that always pass: secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
